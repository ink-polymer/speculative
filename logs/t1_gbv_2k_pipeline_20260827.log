swer within \\boxed{}.", "baseline_tokens": 128, "baseline_ms": 2366.13776255399, "hybrid_tokens": 128, "hybrid_ms": 342.5006363540888, "hybrid_stage_ms": 341.28307012468576, "wall_clock_speedup": 6.908418587893648, "average_committed_per_verify": 15.875, "verify_iterations": 8, "mean_tree_nodes": 43.0, "tree_budget_histogram": {"37": 1, "42": 1, "43": 2, "44": 1, "45": 3}, "draft_decode_ms": 36.75728086382151, "verify_decode_ms": 253.27599906921387, "tree_build_ms": 2.9479051008820534, "greedy_exact_match": null, "first_mismatch_index": null}
